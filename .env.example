# ------------------------------------------------------------------
# NEWS LENS 3D - Environment Configuration Template
# ------------------------------------------------------------------

# 1. External News API (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# 2. Backend Security & Endpoint Protection (Optional)
# Set a secret token to restrict API access. When set, clients must pass
# 'X-API-Key: <token>' or 'Authorization: Bearer <token>'
API_SECRET_KEY=

# 3. Denial of Service & Rate Limiting Controls (Optional)
# Maximum POST request body size in bytes (Default: 262144 = 256 KB)
MAX_PAYLOAD_SIZE=262144

# Maximum API requests allowed per client IP per minute (Default: 60)
RATE_LIMIT_PER_MINUTE=60
